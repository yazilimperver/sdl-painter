{
  "name": "sdl-painter",
  "version": "1.4.0",
  "description": "Modern C++17 2D drawing library for SDL3 with interchangeable OpenGL 3.3 and Vulkan 1.1 backends.",
  "homepage": "https://github.com/yazilimperver/sdl-painter",
  "license": "MIT",
  "supports": "(windows & !uwp) | linux",
  "dependencies": [
    "glad",
    "glm",
    "opengl",
    "sdl3",
    "sdl3-ttf",
    "spdlog",
    "stb",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "vulkan": {
      "description": "Vulkan 1.1 backend",
      "dependencies": [
        "vulkan-headers",
        "vulkan-loader"
      ]
    }
  }
}
